# Dalla versione con RustDesk il backend legge sempre rustdesk.env: sulle installazioni
# precedenti si crea vuoto (RustDesk non configurato) prima del riavvio.
set -e
if [ ! -e rustdesk.env ]; then
    (umask 077 && : > rustdesk.env)
fi
