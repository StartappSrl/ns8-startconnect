import json
import os
import sys
import agent

event = json.load(sys.stdin)

if event.get("domain") != os.getenv("LDAP_DOMAIN"):
    sys.exit(0)
if "node" in event and str(event["node"]) != os.getenv("NODE_ID"):
    sys.exit(0)

agent.run_helper("systemctl", "--user", "-T", "try-reload-or-restart", "startconnect.service").check_returncode()
