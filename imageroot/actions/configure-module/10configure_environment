import json
import os
import secrets
import sys
import agent

data = json.load(sys.stdin)

agent.set_env("TRAEFIK_HOST", data["host"])
agent.set_env("TRAEFIK_HTTP2HTTPS", data.get("http2https", True))
agent.set_env("LDAP_DOMAIN", data["ldap_domain"])
agent.set_env("ADMIN_GROUP", data.get("admin_group", "domain admins"))
agent.set_env("AUDIT_RETENTION_DAYS", data.get("audit_retention_days", int(os.getenv("AUDIT_RETENTION_DAYS", "365"))))
agent.bind_user_domains([data["ldap_domain"]])

# Chiavi del backend: generate una sola volta e mai mostrate in get-configuration.
# TUNNEL_KEY cifra i token di sessione Guacamole, JWT_SECRET firma le sessioni API.
if not os.path.exists("secrets.env"):
    old_umask = os.umask(0o077)
    try:
        with open("secrets.env.tmp", "w") as fp:
            print("TUNNEL_KEY=" + secrets.token_hex(16), file=fp)  # 32 caratteri = AES-256
            print("JWT_SECRET=" + secrets.token_urlsafe(48), file=fp)
        os.replace("secrets.env.tmp", "secrets.env")
    finally:
        os.umask(old_umask)

# Server RustDesk (facoltativo). Indirizzi e chiave pubblica sono dati pubblici
# (vanno ai client); utente e password di rustdesk-api servono solo a leggere
# l'elenco dei dispositivi e restano in rustdesk.env, mai in get-configuration.
rustdesk = data.get("rustdesk")
if rustdesk is not None:
    agent.set_env("RUSTDESK_ID_SERVER", rustdesk.get("id_server", ""))
    agent.set_env("RUSTDESK_RELAY_SERVER", rustdesk.get("relay_server", "") or rustdesk.get("id_server", ""))
    agent.set_env("RUSTDESK_API_SERVER", rustdesk.get("api_server", ""))
    agent.set_env("RUSTDESK_KEY", rustdesk.get("key", ""))

    current = {}
    if os.path.exists("rustdesk.env"):
        with open("rustdesk.env") as fp:
            for line in fp:
                key, sep, value = line.rstrip("\n").partition("=")
                if sep:
                    current[key] = value
    user = rustdesk.get("api_user", current.get("RUSTDESK_API_USER", ""))
    # Password omessa = invariata; stringa vuota = cancellata
    password = rustdesk["api_password"] if "api_password" in rustdesk else current.get("RUSTDESK_API_PASSWORD", "")
    old_umask = os.umask(0o077)
    try:
        with open("rustdesk.env.tmp", "w") as fp:
            print("RUSTDESK_API_USER=" + user, file=fp)
            print("RUSTDESK_API_PASSWORD=" + password, file=fp)
        os.replace("rustdesk.env.tmp", "rustdesk.env")
    finally:
        os.umask(old_umask)
elif not os.path.exists("rustdesk.env"):
    # Il servizio legge sempre il file: vuoto finché RustDesk non è configurato
    old_umask = os.umask(0o077)
    try:
        open("rustdesk.env", "w").close()
    finally:
        os.umask(old_umask)
