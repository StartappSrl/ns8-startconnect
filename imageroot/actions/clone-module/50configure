import os
import agent

result = agent.tasks.run(agent_id=os.environ["AGENT_ID"], action="configure-module", data={
    "host": os.environ["TRAEFIK_HOST"],
    "http2https": os.environ.get("TRAEFIK_HTTP2HTTPS") == "True",
    "ldap_domain": os.environ["LDAP_DOMAIN"],
    "admin_group": os.environ.get("ADMIN_GROUP", "domain admins"),
})
agent.assert_exp(result["exit_code"] == 0, "The configure-module subtask failed!")
