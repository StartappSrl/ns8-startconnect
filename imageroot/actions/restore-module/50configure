import json
import os
import sys
import agent

request = json.load(sys.stdin)
renv = request["environment"]

result = agent.tasks.run(agent_id=os.environ["AGENT_ID"], action="configure-module", data={
    "host": renv["TRAEFIK_HOST"],
    "http2https": renv.get("TRAEFIK_HTTP2HTTPS") == "True",
    "ldap_domain": renv["LDAP_DOMAIN"],
    "admin_group": renv.get("ADMIN_GROUP", "domain admins"),
})
agent.assert_exp(result["exit_code"] == 0, "The configure-module subtask failed!")
