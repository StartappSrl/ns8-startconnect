import json
import sys
import agent

request = json.load(sys.stdin)
renv = request["environment"]

for evar in ["TRAEFIK_HOST", "TRAEFIK_HTTP2HTTPS", "LDAP_DOMAIN", "ADMIN_GROUP", "AUDIT_RETENTION_DAYS"]:
    if evar in renv:
        agent.set_env(evar, renv[evar])
