{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/startconnect/get-configuration-output.json",
    "description": "Get StartConnect configuration",
    "type": "object",
    "properties": {
        "host": {"type": "string"},
        "http2https": {"type": "boolean"},
        "lets_encrypt": {"type": "boolean"},
        "ldap_domain": {"type": "string"},
        "admin_group": {"type": "string"},
        "audit_retention_days": {"type": "integer"},
        "domains_list": {"type": "array"},
        "rustdesk": {
            "type": "object",
            "properties": {
                "id_server": {"type": "string"},
                "relay_server": {"type": "string"},
                "api_server": {"type": "string"},
                "key": {"type": "string"},
                "api_user": {"type": "string"},
                "api_password_set": {"type": "boolean"}
            }
        }
    }
}
