import json
import os
import sys
import agent
from agent.ldapproxy import Ldapproxy

domains = [{"name": d, "label": d, "value": d} for d in Ldapproxy().get_domains_list()]

config = {
    "host": os.getenv("TRAEFIK_HOST", ""),
    "http2https": os.getenv("TRAEFIK_HTTP2HTTPS") == "True",
    "lets_encrypt": agent.get_route(os.environ["MODULE_ID"]).get("lets_encrypt", False),
    "ldap_domain": os.getenv("LDAP_DOMAIN", ""),
    "admin_group": os.getenv("ADMIN_GROUP", "domain admins"),
    "audit_retention_days": int(os.getenv("AUDIT_RETENTION_DAYS", "365")),
    "domains_list": domains,
}

# RustDesk: la password di rustdesk-api non esce mai, si indica solo se è impostata
rustdesk_secrets = {}
if os.path.exists("rustdesk.env"):
    with open("rustdesk.env") as fp:
        for line in fp:
            key, sep, value = line.rstrip("\n").partition("=")
            if sep:
                rustdesk_secrets[key] = value
config["rustdesk"] = {
    "id_server": os.getenv("RUSTDESK_ID_SERVER", ""),
    "relay_server": os.getenv("RUSTDESK_RELAY_SERVER", ""),
    "api_server": os.getenv("RUSTDESK_API_SERVER", ""),
    "key": os.getenv("RUSTDESK_KEY", ""),
    "api_user": rustdesk_secrets.get("RUSTDESK_API_USER", ""),
    "api_password_set": bool(rustdesk_secrets.get("RUSTDESK_API_PASSWORD")),
}

json.dump(config, fp=sys.stdout)
