[Unit]
Description=StartConnect backend
BindsTo=startconnect.service
After=startconnect.service guacd.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p data
# Nel container il backend gira come utente "node" (uid 1000), che con il pod in
# keep-id corrisponde all'utente del modulo. "podman unshare chown 0:0" assegna i dati
# all'utente del modulo e riporta a lui anche i file creati dalle versioni precedenti
# (allora appartenevano a un subuid).
ExecStartPre=/usr/bin/podman unshare chown -R 0:0 data
ExecStartPre=/bin/rm -f %t/startconnect-app.pid %t/startconnect-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/startconnect-app.pid \
    --cidfile %t/startconnect-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/startconnect.pod-id --replace -d --name startconnect-app \
    --env-file=%E/state/ldap.env \
    --env-file=%E/state/secrets.env \
    --env-file=%E/state/rustdesk.env \
    --env RUSTDESK_ID_SERVER=${RUSTDESK_ID_SERVER} \
    --env RUSTDESK_RELAY_SERVER=${RUSTDESK_RELAY_SERVER} \
    --env RUSTDESK_API_SERVER=${RUSTDESK_API_SERVER} \
    --env RUSTDESK_KEY=${RUSTDESK_KEY} \
    --env ADMIN_GROUP=${ADMIN_GROUP} \
    --env AUDIT_RETENTION_DAYS=${AUDIT_RETENTION_DAYS} \
    --env PUBLIC_HOST=${TRAEFIK_HOST} \
    --env STARTCONNECT_APP_IMAGE=${STARTCONNECT_APP_IMAGE} \
    --env GUACD_HOST=127.0.0.1 \
    --env GUACD_PORT=4822 \
    --env DATA_DIR=/data \
    --volume %E/state/data:/data:Z \
    ${STARTCONNECT_APP_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/startconnect-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/startconnect-app.ctr-id
PIDFile=%t/startconnect-app.pid
Type=forking

[Install]
WantedBy=default.target
